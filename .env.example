ENV=DEV
MARKET_PROVIDER=MOCK
MOCK_SCENARIO=BREAKOUT
LOG_LEVEL=INFO

# KIS credentials are required only when MARKET_PROVIDER=KIS.
KIS_MODE=VIRTUAL
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=
KIS_ACCOUNT=

# Decimal validation assumptions. Keep zero until reviewed for your account.
TITAN_BUY_FEE_RATE=0
TITAN_SELL_FEE_RATE=0
TITAN_SELL_TAX_RATE=0
TITAN_ENTRY_SLIPPAGE_RATE=0
TITAN_EXIT_SLIPPAGE_RATE=0
